<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 400" width="100%" height="100%">
      <defs>
        <linearGradient id="grad" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="#245c4f"/>
          <stop offset="100%" stop-color="#102D27"/>
        </linearGradient>
      </defs>
      <rect width="600" height="400" fill="url(#grad)"/>
      <circle cx="500" cy="80" r="140" fill="#ffffff" opacity="0.06"/>
      <circle cx="100" cy="350" r="180" fill="#ffffff" opacity="0.04"/>
      <!-- Decorative Mountain silhouettes -->
      <polygon points="40,360 160,200 280,360" fill="#0d231e" opacity="0.3"/>
      <polygon points="180,360 340,160 500,360" fill="#0d231e" opacity="0.4"/>
      
      <!-- Icon representation -->
      <g transform="translate(300, 150)" text-anchor="middle">
        <circle cx="0" cy="0" r="48" fill="#E99A45" opacity="0.9"/>
        <text x="0" y="14" font-family="sans-serif" font-size="40" fill="#ffffff" font-weight="bold">&#9650;</text>
      </g>
      
      <!-- Text details -->
      <text x="300" y="245" font-family="system-ui, sans-serif" font-size="22" font-weight="800" fill="#ffffff" text-anchor="middle">Dome Arei Halimun 4P</text>
      <text x="300" y="275" font-family="system-ui, sans-serif" font-size="15" font-weight="600" fill="#E99A45" text-anchor="middle">Arei &bull; Tenda</text>
      <text x="300" y="325" font-family="system-ui, sans-serif" font-size="12" font-weight="bold" fill="#A8B8A0" text-anchor="middle" letter-spacing="2">ORIGINAL OUTDOOR GEAR</text>
    </svg>